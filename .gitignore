# Build and release output (including generated C headers)
/build/
/dist/
/cpa-plugin-set-proxies_*.zip
/cpa-plugin-set-proxies_*.tar.gz
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Coverage and profiling output
/coverage/
coverage.out
coverage.html
*.coverprofile
*.prof
profile.cov

# Local Go workspace; keep go.mod and go.sum tracked
go.work
go.work.sum

# Local secrets and configuration; keep examples tracked
.env
.env.*
!.env.example
!.env.sample
/config.yaml
/config.local.yaml
/data.py
/data/

# Python test cache
__pycache__/
*.py[cod]
.venv/

# Local editor, agent, and OS state
.idea/
.vscode/
/.trellis/
/.pi/
/.agent/
/.claude/
/.opencode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
